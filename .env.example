# DEVos Environment Configuration Template
# Copy this file to .env or set these in your CI/CD environment.

# Optional HTTPS URL for stock A.119 BOOT image download in GitHub Actions
STOCK_BOOT_URL=https://example.com/boot.img

# Expected 64-character SHA-256 hex digest for the stock BOOT image
STOCK_BOOT_SHA256=5a77b4405cfa5b5399d7b3f1822ba57bcf4e386232ef7aab1bf7b39e6159f51e

# Boot selector default mode:
#   1 = Pocket VPS (Linux micro-server, USB-RNDIS, SSH)
#   2 = Wi-Fi Router (AP hotspot, DHCP gateway, NAT routing)
#   3 = Dual Mode (Pocket VPS + Wi-Fi Router combined)
#   4 = Regular Barebones (Stock Android, camera/mic/cell phone)
DEVOS_DEFAULT_MODE=4

# Timeout in seconds before auto-booting DEVOS_DEFAULT_MODE
DEVOS_BOOT_TIMEOUT=5
